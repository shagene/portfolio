---
import { getImage } from "astro:assets";
import headshot from "@/assets/stevenprofile.png";
import { site } from "@/data/portfolio";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogType?: "profile" | "website" | "article";
  robots?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = `${site.name} | ${site.title}`,
  description = site.description,
  ogImagePath = "/og-image.png",
  ogImageAlt = `${site.name}, ${site.title}`,
  ogType = "profile",
  robots = "index, follow",
  canonicalPath = Astro.url.pathname,
  structuredData = [],
} = Astro.props;
const canonical = new URL(canonicalPath, site.canonical);
const ogImage = new URL(ogImagePath, site.canonical);
const optimizedHeadshot = await getImage({ src: headshot, width: 720, format: "webp" });
const personId = `${site.canonical}/#person`;
const organizationId = `${site.semper.url}#organization`;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: site.name,
  url: site.canonical,
  image: new URL(optimizedHeadshot.src, site.canonical).toString(),
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Clayton",
    addressRegion: "NC",
    addressCountry: "US",
  },
  sameAs: [site.github, site.linkedin],
  worksFor: {
    "@type": "Organization",
    "@id": organizationId,
    name: site.semper.name,
    url: site.semper.url,
  },
};
const schemas = [personSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c141a" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
