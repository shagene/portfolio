---
import { copy, credentials, experiences } from "@/data/portfolio";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section shell" id="experience" aria-labelledby="experience-heading">
  <SectionHeading
    number={copy.experience.number}
    title={copy.experience.title}
    intro={copy.experience.intro}
  >
    <span id="experience-heading">{copy.experience.heading}</span>
  </SectionHeading>

  <ol class="timeline">
    {experiences.map((experience) => (
      <li class:list={{ compressed: experience.compact }}>
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-period">
          <span>{experience.period}</span>
          {experience.concurrent && <small>Concurrent with Semper</small>}
        </div>
        <div class="timeline-content">
          <h3>{experience.company}</h3>
          {experience.role && <p class="role">{experience.role}</p>}
          {experience.detail && <p class="detail">{experience.detail}</p>}
        </div>
      </li>
    ))}
  </ol>

  <div class="credentials" role="group" aria-label="Credentials">
    <p class="eyebrow">Credentials</p>
    <ul>
      {credentials.map((credential) => <li>{credential}</li>)}
    </ul>
  </div>
</section>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(10rem, 0.55fr) minmax(0, 1.45fr);
    gap: var(--primitive-space-6);
    padding-bottom: clamp(var(--primitive-space-10), 5vw, var(--primitive-space-16));
  }

  .timeline li::before {
    position: absolute;
    top: 0.6rem;
    bottom: 0;
    left: 0.34rem;
    width: 1px;
    background: var(--color-border-strong);
    content: "";
  }

  .timeline li:last-child::before {
    display: none;
  }

  .timeline-marker {
    position: relative;
    z-index: 1;
    width: 0.72rem;
    height: 0.72rem;
    margin-top: 0.45rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface);
  }

  .timeline-period {
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-small);
    line-height: 1.5;
  }

  .timeline-period small {
    display: block;
    margin-top: var(--primitive-space-2);
    color: var(--color-accent-soft);
    font-size: var(--primitive-type-micro);
  }

  h3 {
    margin: 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .role {
    margin: var(--primitive-space-1) 0 0;
    color: var(--color-accent-soft);
    font-size: var(--primitive-type-small);
    font-weight: 700;
  }

  .detail {
    max-width: 45rem;
    margin: var(--primitive-space-4) 0 0;
    color: var(--color-ink-muted);
  }

  .compressed {
    padding-bottom: var(--primitive-space-8) !important;
  }

  .compressed h3 {
    font-size: 1.1rem;
  }

  .credentials {
    display: grid;
    grid-template-columns: minmax(9rem, 0.5fr) minmax(0, 1.5fr);
    gap: var(--space-cluster);
    margin-top: var(--primitive-space-12);
    padding-block: var(--primitive-space-8);
    border-block: 1px solid var(--color-border-strong);
  }

  .credentials ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--primitive-space-3) var(--primitive-space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credentials li {
    color: var(--color-ink-muted);
  }

  .credentials li::before {
    margin-right: var(--primitive-space-3);
    color: var(--color-accent);
    content: "·";
  }

  @media (max-width: 47.99rem) {
    .timeline li {
      grid-template-columns: 1rem 1fr;
      gap: var(--primitive-space-4);
    }

    .timeline-period,
    .timeline-content {
      grid-column: 2;
    }

    .timeline-period {
      grid-row: 1;
    }

    .timeline-content {
      grid-row: 2;
    }

    .timeline-marker {
      grid-row: 1 / 3;
    }

    .timeline li::before {
      left: 0.34rem;
    }

    .credentials {
      grid-template-columns: 1fr;
    }
  }
</style>
