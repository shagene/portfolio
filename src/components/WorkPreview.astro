---
import { caseStudies, copy } from "@/data/portfolio";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section shell" id="work" aria-labelledby="work-heading">
  <SectionHeading
    number={copy.work.number}
    title={copy.work.title}
    intro={copy.work.intro}
  >
    <span id="work-heading">{copy.work.heading}</span>
  </SectionHeading>

  <div class="work-grid">
    {caseStudies.map((study) => (
      <article>
        <div class="card-meta">
          <span>{study.number}</span>
          <span>{study.domain}</span>
        </div>
        <div class="card-title">
          <h3>{study.name}</h3>
          <p>{study.role}</p>
        </div>
        <p class="problem">{study.problem}</p>
        <p class="what-built"><span>What I built</span>{study.previewBuilt}</p>
        <a href={study.path} aria-label={`Read the ${study.name} case study`}>
          Read case study <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>

  <p class="all-work"><a href="/work/">Explore all selected work <span aria-hidden="true">→</span></a></p>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--primitive-space-4);
  }

  article {
    display: flex;
    min-height: 32rem;
    flex-direction: column;
    padding: clamp(var(--primitive-space-6), 3vw, var(--primitive-space-10));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  article:nth-child(2) {
    background: color-mix(in srgb, var(--card-bg) 78%, var(--color-surface-strong));
  }

  .card-meta {
    display: flex;
    min-height: 2.75rem;
    gap: var(--primitive-space-4);
    justify-content: space-between;
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    line-height: 1.45;
  }

  .card-meta span:first-child {
    color: var(--color-accent);
  }

  .card-meta span:last-child {
    max-width: 12rem;
    text-align: right;
  }

  .card-title {
    margin: auto 0 var(--primitive-space-5);
  }

  h3 {
    margin: 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h2);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .card-title p {
    margin: var(--primitive-space-2) 0 0;
    color: var(--color-accent-soft);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-small);
  }

  .problem {
    margin: 0 0 var(--primitive-space-5);
    color: var(--color-ink-muted);
  }

  .what-built {
    margin: 0 0 var(--primitive-space-8);
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-small);
  }

  .what-built span {
    display: block;
    margin-bottom: var(--primitive-space-2);
    color: var(--color-accent-soft);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  article > a,
  .all-work a {
    display: inline-flex;
    gap: var(--primitive-space-3);
    align-items: center;
    color: var(--color-ink);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-small);
    font-weight: 700;
    text-decoration-color: var(--color-accent);
  }

  article > a {
    margin-top: auto;
  }

  article > a span,
  .all-work span {
    color: var(--color-accent);
  }

  .all-work {
    margin: var(--primitive-space-8) 0 0;
    text-align: right;
  }

  @media (max-width: 63.99rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }

    article {
      min-height: 27rem;
    }
  }

  @media (max-width: 47.99rem) {
    article {
      min-height: 28rem;
    }
  }
</style>
