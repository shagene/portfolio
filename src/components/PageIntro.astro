---
type Props = {
  eyebrow: string;
  headline: string;
  lead: string;
  backHref?: string;
  backLabel?: string;
};

const { eyebrow, headline, lead, backHref = "/", backLabel = "← Portfolio" } = Astro.props;
---

<section class="page-intro shell" id="page-intro" aria-labelledby="page-title">
  <a class="back-link" href={backHref}>{backLabel}</a>
  <div class="intro-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-title">{headline}</h1>
    </div>
    <div class="intro-copy">
      <p>{lead}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .page-intro {
    padding-block: clamp(var(--primitive-space-12), 7vw, var(--primitive-space-24));
  }

  .back-link {
    display: inline-block;
    margin-bottom: clamp(var(--primitive-space-12), 6vw, var(--primitive-space-20));
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    gap: var(--space-cluster);
    align-items: end;
  }

  h1 {
    max-width: 11ch;
    margin: var(--primitive-space-5) 0 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-hero);
    font-weight: 720;
    letter-spacing: var(--primitive-tracking-display);
    line-height: var(--primitive-leading-hero);
    text-wrap: balance;
  }

  .intro-copy > p {
    max-width: 42rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-lead);
  }

  .intro-copy :global(.page-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--primitive-space-5);
    margin-top: var(--primitive-space-8);
  }

  @media (max-width: 47.99rem) {
    .intro-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }
  }
</style>
