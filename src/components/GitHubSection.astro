---
import { copy, portfolioSource, privateEngineeringWork } from "@/data/portfolio";
import type { GitHubActivity, GitHubContributionDay } from "@/data/github";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  activity: GitHubActivity | null;
  number?: string;
};

const { activity, number = "01" } = Astro.props;
const numberFormat = new Intl.NumberFormat("en-US");
const formatDate = (value: string, includeDay = true) => new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: includeDay ? "numeric" : undefined,
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${value.slice(0, 10)}T12:00:00Z`));

const contributionLabel = activity?.combined.publicContributions === null
  ? "Public-profile contributions"
  : "Public contributions";
const contributionValue = activity
  ? activity.combined.publicContributions ?? activity.combined.visibleContributions
  : null;

const cellSize = 10;
const cellGap = 3;
const labelWidth = 30;
const chartTop = 24;
const rowStep = cellSize + cellGap;
const calendar = activity?.combined.calendar ?? [];
const firstCalendarDay = calendar.at(0);
const startPadding = firstCalendarDay
  ? new Date(`${firstCalendarDay.date}T12:00:00Z`).getUTCDay()
  : 0;
const padded: Array<GitHubContributionDay | null> = [
  ...Array.from({ length: startPadding }, () => null),
  ...calendar,
];
while (padded.length % 7 !== 0) padded.push(null);
const weeks = Array.from({ length: padded.length / 7 }, (_, index) =>
  padded.slice(index * 7, (index + 1) * 7));
const chartWidth = labelWidth + (weeks.length * rowStep) + cellGap;
const chartHeight = chartTop + (7 * rowStep) + 22;
const nonZero = calendar.map((day) => day.count).filter((count) => count > 0).sort((a, b) => a - b);
const quantile = (position: number) => nonZero[Math.min(
  nonZero.length - 1,
  Math.floor((nonZero.length - 1) * position),
)] ?? 0;
const thresholds: [number, number, number] = [
  quantile(0.25),
  quantile(0.5),
  quantile(0.75),
];
const level = (count: number) => {
  if (count === 0) return 0;
  if (count <= thresholds[0]) return 1;
  if (count <= thresholds[1]) return 2;
  if (count <= thresholds[2]) return 3;
  return 4;
};
const monthLabels: Array<{ label: string; x: number }> = [];
const personalAccount = activity?.accounts.find((account) => account.login === "shagene");
const companyAccount = activity?.accounts.find(
  (account) => account.login === "semperdigitalsolutions",
);
let previousMonth = "";
weeks.forEach((week, weekIndex) => {
  const firstDay = week.find((day) => day !== null);
  if (!firstDay) return;
  const month = firstDay.date.slice(0, 7);
  if (month !== previousMonth) {
    monthLabels.push({
      label: new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" })
        .format(new Date(`${firstDay.date}T12:00:00Z`)),
      x: labelWidth + (weekIndex * rowStep),
    });
    previousMonth = month;
  }
});
---

<section
  class="section shell github-section"
  id="github"
  aria-labelledby="github-heading"
  data-github-source={activity?.source ?? "unavailable"}
>
  <SectionHeading number={number} title={copy.github.title} intro={copy.github.intro}>
    <span id="github-heading">{copy.github.heading}</span>
  </SectionHeading>

  <div class="proof-block private-proof">
    <div class="block-heading">
      <p class="eyebrow">Selected private engineering</p>
      <h3>Owner-controlled systems I can discuss at the architecture level.</h3>
      <p>
        The code stays private. Each snapshot names the product boundary, my role, what I built,
        and the constraint that shaped the system without publishing protected source.
      </p>
    </div>

    <div class="private-grid">
      {privateEngineeringWork.map((project) => (
        <article class="private-card" data-private-project={project.name}>
          <div class="private-meta">
            <span>{project.number}</span>
            <span>{project.role}</span>
          </div>
          <p class="private-access">{project.ownership}</p>
          <h4>{project.name}</h4>
          <p class="private-domain">{project.domain}</p>
          <p class="private-detail"><span>What I built</span>{project.built}</p>
          <p class="private-detail"><span>Hard constraint</span>{project.constraint}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="block-heading activity-heading">
    <p class="eyebrow">Supporting signal</p>
    <h3>One public activity view across both accounts.</h3>
    <p>
      The calendar and repository statistics establish visible recency and breadth. They support the
      private-engineering evidence above; they do not replace it.
    </p>
  </div>

  {activity ? (
    <>
      <dl class="stats" aria-label="Combined GitHub statistics captured at build time">
        <div>
          <dt>{contributionLabel} · 12 mo</dt>
          <dd>{numberFormat.format(contributionValue ?? 0)}</dd>
        </div>
        <div>
          <dt>Combined public repos</dt>
          <dd>{numberFormat.format(activity.combined.publicRepos)}</dd>
        </div>
        <div>
          <dt>Top languages by bytes</dt>
          <dd class="languages">{activity.combined.topLanguages.slice(0, 4).map((item) => item.name).join(" · ")}</dd>
        </div>
        <div>
          <dt>Latest public activity</dt>
          <dd>{formatDate(activity.combined.latestPublicActivity)}</dd>
        </div>
      </dl>

      <div class="heatmap-panel">
        <div class="heatmap-heading">
          <div>
            <p class="eyebrow">Trailing 12 months</p>
            <h3>One combined contribution calendar.</h3>
          </div>
          <p>{numberFormat.format(activity.combined.visibleContributions)} contributions visible across both public profiles.</p>
        </div>

        <p class="heatmap-scroll-note" id="heatmap-scroll-note">Scroll horizontally to inspect the full year.</p>
        <div
          class="heatmap-scroll"
          tabindex="0"
          role="region"
          aria-label="Scrollable combined GitHub contribution calendar"
          aria-describedby="heatmap-scroll-note"
        >
          <svg
            class="heatmap"
            viewBox={`0 0 ${chartWidth} ${chartHeight}`}
            width={chartWidth}
            height={chartHeight}
            role="img"
            aria-labelledby="heatmap-title heatmap-description"
          >
            <title id="heatmap-title">Combined GitHub contribution activity</title>
            <desc id="heatmap-description">
              Daily activity visible across shagene and semperdigitalsolutions from {formatDate(activity.range.from)} through {formatDate(activity.range.to)}.
            </desc>
            {monthLabels.map((month) => (
              <text class="month" x={month.x} y="11">{month.label}</text>
            ))}
            <text class="weekday" x="2" y={chartTop + rowStep + 8}>M</text>
            <text class="weekday" x="2" y={chartTop + (3 * rowStep) + 8}>W</text>
            <text class="weekday" x="2" y={chartTop + (5 * rowStep) + 8}>F</text>
            {weeks.map((week, weekIndex) => week.map((day, dayIndex) => day && (
              <rect
                class={`level-${level(day.count)}`}
                x={labelWidth + (weekIndex * rowStep)}
                y={chartTop + (dayIndex * rowStep)}
                width={cellSize}
                height={cellSize}
                rx="1.5"
              >
                <title>{day.count === 0 ? "No" : numberFormat.format(day.count)} {day.count === 1 ? "contribution" : "contributions"} on {formatDate(day.date)}</title>
              </rect>
            )))}
          </svg>
        </div>

        <div class="heatmap-footer">
          <p>{activity.source === "live" ? "Live build data" : "Cached build data"} as of {formatDate(activity.dataAsOf)}.</p>
          <div class="legend" aria-label="Contribution intensity from less to more">
            <span>Less</span>
            {[0, 1, 2, 3, 4].map((item) => <i class={`level-${item}`} aria-hidden="true"></i>)}
            <span>More</span>
          </div>
        </div>
      </div>

      <div class="attribution">
        <p>
          Combined activity visible across my <a href={personalAccount?.profileUrl ?? "https://github.com/shagene"}>personal account</a> and <a href={companyAccount?.profileUrl ?? "https://github.com/semperdigitalsolutions"}>Semper Digital Solutions</a>. Client repositories remain private; these are the public profiles and repositories.
        </p>
        <p class="data-boundary">
          {activity.combined.restrictedContributions === null
            ? "GitHub's public profile calendar can include anonymized private contributions. This cached snapshot cannot separate those contributions by day."
            : activity.combined.restrictedContributions > 0
              ? `GitHub includes ${numberFormat.format(activity.combined.restrictedContributions)} anonymized private contributions in the visible calendar. The public-contribution statistic excludes them.`
              : "GitHub reported no restricted contributions in this calendar range."}
        </p>
      </div>
    </>
  ) : (
    <aside class="fallback" aria-label="GitHub activity data status">
      <p class="eyebrow">Static fallback</p>
      <h3>Activity data is temporarily unavailable.</h3>
      <p>The private engineering summaries and source for this site remain available, so a transient API or cache failure never leaves an empty section.</p>
    </aside>
  )}

  <aside class="source-panel" aria-labelledby="source-heading">
    <div>
      <p class="eyebrow">Public source</p>
      <h3 id="source-heading">{portfolioSource.name}</h3>
      <p>{portfolioSource.description}</p>
    </div>
    <div class="source-meta">
      <p>{portfolioSource.stack}</p>
      <a class="text-link" href={portfolioSource.href} rel="noreferrer">{portfolioSource.repository}</a>
    </div>
  </aside>
</section>

<style>
  .proof-block {
    margin-bottom: clamp(var(--primitive-space-20), 9vw, var(--primitive-space-32));
  }

  .block-heading {
    display: grid;
    grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--primitive-space-4) var(--space-cluster);
    align-items: start;
    margin-bottom: var(--primitive-space-10);
  }

  .block-heading .eyebrow {
    grid-row: 1 / span 2;
    padding-top: 0.3rem;
  }

  .block-heading h3 {
    max-width: 24ch;
    margin: 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h2);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .block-heading > p:last-child {
    max-width: 48rem;
    margin: 0;
    color: var(--color-ink-muted);
  }

  .activity-heading {
    padding-top: clamp(var(--primitive-space-12), 6vw, var(--primitive-space-20));
    border-top: 1px solid var(--color-border-strong);
  }

  .private-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--primitive-space-4);
  }

  .private-card {
    display: flex;
    min-height: 33rem;
    flex-direction: column;
    padding: clamp(var(--primitive-space-6), 3vw, var(--primitive-space-9));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .private-card:nth-child(2) {
    background: color-mix(in srgb, var(--card-bg) 78%, var(--color-surface-strong));
  }

  .private-meta {
    display: flex;
    gap: var(--primitive-space-4);
    justify-content: space-between;
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .private-meta span:first-child { color: var(--color-accent); }
  .private-meta span:last-child { max-width: 13rem; text-align: right; }

  .private-access {
    margin: var(--primitive-space-4) 0 0;
    color: var(--color-accent-soft);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .private-card h4 {
    margin: var(--primitive-space-10) 0 var(--primitive-space-1);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h2);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .private-domain {
    margin: 0 0 var(--primitive-space-7);
    color: var(--color-ink-subtle);
    font-size: var(--primitive-type-small);
  }

  .private-detail {
    margin: 0 0 var(--primitive-space-6);
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-small);
  }

  .private-detail span {
    display: block;
    margin-bottom: var(--primitive-space-2);
    color: var(--color-accent-soft);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 var(--primitive-space-12);
    border-block: 1px solid var(--color-border-strong);
  }

  .stats div {
    min-width: 0;
    padding: var(--primitive-space-5) var(--primitive-space-6);
  }

  .stats div:first-child { padding-left: 0; }
  .stats div + div { border-left: 1px solid var(--color-border); }

  .stats dt {
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stats dd {
    margin: var(--primitive-space-1) 0 0;
    color: var(--color-ink);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-lead);
    font-weight: 650;
  }

  .stats .languages { font-size: 1rem; }

  .heatmap-panel {
    padding: clamp(var(--primitive-space-5), 4vw, var(--primitive-space-10));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .heatmap-heading {
    display: flex;
    gap: var(--primitive-space-8);
    align-items: end;
    justify-content: space-between;
    margin-bottom: var(--primitive-space-8);
  }

  .heatmap-heading h3 {
    margin: var(--primitive-space-2) 0 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
    letter-spacing: var(--primitive-tracking-heading);
  }

  .heatmap-heading > p {
    max-width: 27rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-small);
    text-align: right;
  }

  .heatmap-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-bottom: var(--primitive-space-2);
    scrollbar-color: var(--color-border-strong) transparent;
    direction: rtl;
  }

  .heatmap {
    display: block;
    width: 100%;
    min-width: 48rem;
    height: auto;
    direction: ltr;
  }

  .heatmap-scroll-note {
    display: none;
    margin: 0 0 var(--primitive-space-3);
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
  }

  .heatmap :global(.month),
  .heatmap :global(.weekday) {
    fill: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: 8px;
  }

  .heatmap :global(.level-0),
  .legend .level-0 { fill: var(--color-surface-strong); background: var(--color-surface-strong); }
  .heatmap :global(.level-1),
  .legend .level-1 { fill: color-mix(in srgb, var(--color-accent) 30%, var(--color-surface-raised)); background: color-mix(in srgb, var(--color-accent) 30%, var(--color-surface-raised)); }
  .heatmap :global(.level-2),
  .legend .level-2 { fill: color-mix(in srgb, var(--color-accent) 55%, var(--color-surface-raised)); background: color-mix(in srgb, var(--color-accent) 55%, var(--color-surface-raised)); }
  .heatmap :global(.level-3),
  .legend .level-3 { fill: var(--primitive-copper-500); background: var(--primitive-copper-500); }
  .heatmap :global(.level-4),
  .legend .level-4 { fill: var(--primitive-copper-300); background: var(--primitive-copper-300); }

  .heatmap-footer {
    display: flex;
    gap: var(--primitive-space-6);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--primitive-space-4);
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
  }

  .heatmap-footer p { margin: 0; }

  .legend {
    display: flex;
    gap: var(--primitive-space-2);
    align-items: center;
  }

  .legend i {
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 0.1rem;
  }

  .attribution {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--primitive-space-6);
    margin: var(--primitive-space-5) 0 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-small);
  }

  .attribution p { margin: 0; }
  .attribution a { color: var(--color-ink); text-decoration-color: var(--color-accent); }
  .data-boundary { color: var(--color-ink-subtle); }

  .fallback {
    margin-bottom: 0;
    padding: var(--primitive-space-8);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
  }

  .fallback h3 {
    margin: var(--primitive-space-3) 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
  }

  .fallback p:last-child { max-width: 44rem; margin-bottom: 0; color: var(--color-ink-muted); }

  .source-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: var(--space-cluster);
    align-items: end;
    margin-top: clamp(var(--primitive-space-16), 8vw, var(--primitive-space-24));
    padding: clamp(var(--primitive-space-6), 4vw, var(--primitive-space-10));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .source-panel h3 {
    margin: var(--primitive-space-3) 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h2);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .source-panel > div:first-child > p:last-child {
    max-width: 48rem;
    margin: 0;
    color: var(--color-ink-muted);
  }

  .source-meta {
    padding-left: var(--primitive-space-6);
    border-left: 1px solid var(--color-border-strong);
  }

  .source-meta p {
    margin: 0 0 var(--primitive-space-4);
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: 0.06em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .source-meta .text-link { overflow-wrap: anywhere; }

  @media (max-width: 63.99rem) {
    .private-grid { grid-template-columns: 1fr; }
    .private-card { min-height: 0; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats div:nth-child(3) { border-top: 1px solid var(--color-border); border-left: 0; padding-left: 0; }
    .stats div:nth-child(4) { border-top: 1px solid var(--color-border); }
  }

  @media (max-width: 47.99rem) {
    .block-heading { grid-template-columns: 1fr; }
    .block-heading .eyebrow { grid-row: auto; }
    .heatmap-scroll-note { display: block; }
    .heatmap-heading,
    .heatmap-footer { align-items: flex-start; flex-direction: column; }
    .heatmap-heading > p { text-align: left; }
    .attribution,
    .source-panel { grid-template-columns: 1fr; }
    .source-meta {
      padding-top: var(--primitive-space-5);
      padding-left: 0;
      border-top: 1px solid var(--color-border-strong);
      border-left: 0;
    }
  }

  @media (max-width: 29.99rem) {
    .stats { grid-template-columns: 1fr; }
    .stats div { padding-inline: 0; }
    .stats div + div,
    .stats div:nth-child(4) { border-top: 1px solid var(--color-border); border-left: 0; }
  }
</style>
