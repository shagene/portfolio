---
import { copy, curatedRepos, site } from "@/data/portfolio";
import type { GitHubStats } from "@/data/github";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  stats: GitHubStats | null;
};

const { stats } = Astro.props;
---

<section class="section shell" id="github" aria-labelledby="github-heading">
  <SectionHeading
    number={copy.github.number}
    title={copy.github.title}
    intro={copy.github.intro}
  >
    <span id="github-heading">{copy.github.heading}</span>
  </SectionHeading>

  {stats && (
    <dl class="stats" aria-label="Live public GitHub statistics captured at build time">
      <div>
        <dt>Public repositories</dt>
        <dd>{stats.publicRepos}</dd>
      </div>
      <div>
        <dt>Top public languages</dt>
        <dd>{stats.topLanguages.join(" · ")}</dd>
      </div>
      <div>
        <dt>Latest public push</dt>
        <dd>{stats.latestPublicPush}</dd>
      </div>
    </dl>
  )}

  <div class="repo-grid">
    {curatedRepos.map((repo, index) => (
      <article class="repo-card">
        <div class="repo-meta">
          <span>0{index + 1}</span>
          <span>{repo.language}</span>
        </div>
        <h3>{repo.name}</h3>
        <p>{repo.description}</p>
        <a class="text-link" href={repo.href} rel="noreferrer">{repo.repository}</a>
      </article>
    ))}
  </div>

  <p class="github-link">
    <a class="text-link" href={site.github} rel="me">View the complete public profile</a>
  </p>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 var(--primitive-space-12);
    border-block: 1px solid var(--color-border-strong);
  }

  .stats div {
    padding: var(--primitive-space-5) var(--primitive-space-6);
  }

  .stats div:first-child {
    padding-left: 0;
  }

  .stats div + div {
    border-left: 1px solid var(--color-border);
  }

  .stats dt {
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stats dd {
    margin: var(--primitive-space-1) 0 0;
    color: var(--color-ink);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-lead);
    font-weight: 650;
  }

  .repo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--primitive-space-4);
  }

  .repo-card {
    display: flex;
    min-height: 21rem;
    flex-direction: column;
    padding: clamp(var(--primitive-space-6), 4vw, var(--primitive-space-10));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
  }

  .repo-card:nth-child(2),
  .repo-card:nth-child(3) {
    background: color-mix(in srgb, var(--card-bg) 78%, var(--color-surface-strong));
  }

  .repo-meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .repo-meta span:first-child {
    color: var(--color-accent);
  }

  h3 {
    max-width: 16ch;
    margin: auto 0 var(--primitive-space-5);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
    letter-spacing: var(--primitive-tracking-heading);
  }

  .repo-card p {
    max-width: 36rem;
    margin: 0 0 var(--primitive-space-8);
    color: var(--color-ink-muted);
  }

  .repo-card .text-link {
    margin-top: auto;
  }

  .github-link {
    margin: var(--primitive-space-8) 0 0;
    text-align: right;
  }

  @media (max-width: 47.99rem) {
    .stats,
    .repo-grid {
      grid-template-columns: 1fr;
    }

    .stats div {
      padding-inline: 0;
    }

    .stats div + div {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .repo-card {
      min-height: 18rem;
    }
  }
</style>
