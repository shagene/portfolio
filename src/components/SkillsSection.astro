---
import { copy, skillGroups } from "@/data/portfolio";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section shell" id="skills" aria-labelledby="skills-heading">
  <SectionHeading
    number={copy.skills.number}
    title={copy.skills.title}
    intro={copy.skills.intro}
  >
    <span id="skills-heading">{copy.skills.heading}</span>
  </SectionHeading>

  <div class="skill-groups">
    {skillGroups.map((group, index) => (
      <article>
        <header>
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{group.name}</h3>
        </header>
        <ul class="chips">
          {group.skills.map((skill) => <li class="chip">{skill}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .skill-groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-border-strong);
  }

  article {
    min-height: 19rem;
    padding: var(--primitive-space-10);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  article:nth-child(even) {
    border-right: 0;
  }

  header {
    display: flex;
    gap: var(--primitive-space-4);
    align-items: baseline;
    margin-bottom: var(--primitive-space-10);
  }

  header span {
    color: var(--color-accent);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
  }

  h3 {
    margin: 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
    letter-spacing: var(--primitive-tracking-heading);
  }

  @media (max-width: 47.99rem) {
    .skill-groups {
      grid-template-columns: 1fr;
    }

    article {
      min-height: auto;
      padding-inline: 0;
      border-right: 0;
    }
  }
</style>
