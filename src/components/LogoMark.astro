---
type Props = {
  titleId?: string;
  variant?: "dark" | "light";
};

const {
  titleId = "steven-hagene-logo-title",
  variant = "dark",
} = Astro.props;
---

<svg
  class="logo-mark"
  data-variant={variant}
  viewBox="0 0 64 64"
  role="img"
  aria-labelledby={titleId}
  focusable="false"
>
  <title id={titleId}>Steven Hagene SH monogram</title>
  <g fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter">
    <circle cx="32" cy="32" r="27" stroke-width="4"></circle>
    <path d="M29 20H17v12h12v12H17" stroke-width="5"></path>
    <path d="M35 8v48m0-24h12m0-12v24" stroke-width="5"></path>
  </g>
</svg>

<style>
  .logo-mark {
    display: block;
    width: var(--logo-mark-size-nav);
    height: var(--logo-mark-size-nav);
    flex: none;
    color: var(--logo-mark-dark);
  }

  .logo-mark[data-variant="light"] {
    color: var(--logo-mark-light);
  }
</style>
