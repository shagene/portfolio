---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LogoMark from "@/components/LogoMark.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Steven Hagene"
  description="The requested page does not exist. Return to Steven Hagene's portfolio or engineering case studies."
  robots="noindex, nofollow"
  canonicalPath="/404/"
  ogType="website"
>
  <Header />
  <main id="main-content">
    <section class="not-found shell" aria-labelledby="not-found-heading">
      <div class="error-mark" aria-hidden="true"><LogoMark titleId="error-logo-title" /></div>
      <p class="eyebrow">404 · Route not found</p>
      <h1 id="not-found-heading">This path ends here.</h1>
      <p>The page may have moved, or the address may be mistyped. The work and the rest of the site are still intact.</p>
      <div class="actions">
        <a class="primary-link" href="/">Return home</a>
        <a class="text-link" href="/work/">Explore selected work</a>
        <a class="text-link" href="/github/">View engineering proof</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100svh - 10rem);
    align-content: center;
    padding-block: var(--space-section);
  }

  .error-mark {
    width: 4rem;
    margin-bottom: var(--primitive-space-8);
  }

  .error-mark :global(.logo-mark) {
    width: 4rem;
    height: 4rem;
  }

  h1 {
    max-width: 10ch;
    margin: var(--primitive-space-4) 0 var(--primitive-space-6);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-hero);
    letter-spacing: var(--primitive-tracking-display);
    line-height: var(--primitive-leading-hero);
  }

  .not-found > p:not(.eyebrow) {
    max-width: 42rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-lead);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--primitive-space-5) var(--primitive-space-8);
    align-items: center;
    margin-top: var(--primitive-space-10);
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--primitive-space-3) var(--primitive-space-5);
    border-radius: var(--primitive-radius-pill);
    background: var(--button-primary-bg);
    color: var(--button-primary-ink);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-small);
    font-weight: 750;
    text-decoration: none;
  }

  .primary-link:hover {
    background: var(--color-accent-soft);
    color: var(--button-primary-ink);
  }
</style>
