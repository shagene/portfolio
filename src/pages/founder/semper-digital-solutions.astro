---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { semperStory, site } from "@/data/portfolio";
import BaseLayout from "@/layouts/BaseLayout.astro";

const pageUrl = new URL(semperStory.path, site.canonical).toString();
const personId = `${site.canonical}/#person`;
const organizationId = `${site.semper.url}#organization`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${pageUrl}#profile-page`,
    url: pageUrl,
    name: semperStory.pageTitle,
    description: semperStory.pageDescription,
    mainEntity: {
      "@type": "Organization",
      "@id": organizationId,
      name: site.semper.name,
      url: site.semper.url,
      description: semperStory.organizationDescription,
      foundingDate: "2024",
      areaServed: "US",
      founder: { "@id": personId },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Steven Hagene",
        item: site.canonical,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Semper Digital Solutions founder case study",
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={semperStory.pageTitle}
  description={semperStory.pageDescription}
  ogImagePath="/og-semper.png"
  ogImageAlt="Steven Hagene, founder of Semper Digital Solutions"
  ogType="article"
  structuredData={structuredData}
>
  <Header />
  <main id="main-content">
    <section class="company-hero shell" id="company" aria-labelledby="company-title">
      <div class="company-intro">
        <a class="back-link" href="/#semper">{semperStory.labels.backLink}</a>
        <p class="eyebrow">{semperStory.eyebrow}</p>
        <h1 id="company-title">{semperStory.headline}</h1>
        <p class="lead">{semperStory.lead}</p>
        <div class="hero-actions">
          <a class="primary-link" href={site.semper.url}>{semperStory.labels.visitCompany}</a>
          <a class="text-link" href={`mailto:${site.email}`}>{semperStory.labels.contact}</a>
        </div>
      </div>

      <aside class="status-ledger" aria-labelledby="status-heading">
        <p class="eyebrow">{semperStory.labels.ledger}</p>
        <h2 id="status-heading">{semperStory.ledgerHeading}</h2>
        <dl>
          {semperStory.status.map((status, index) => (
            <div>
              <dt>0{index + 1}</dt>
              <dd>{status}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </section>

    <section class="founder-section shell" id="operating-model" aria-labelledby="model-heading">
      <header class="page-section-heading">
        <div>
          <p class="eyebrow">{semperStory.operatingSection.eyebrow}</p>
          <h2 id="model-heading">{semperStory.operatingSection.heading}</h2>
        </div>
        <p>{semperStory.operatingSection.intro}</p>
      </header>

      <div class="model-grid">
        <div class="model-statement">
          {semperStory.operatingSection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="capability-panel" aria-labelledby="capability-heading">
          <p class="eyebrow" id="capability-heading">{semperStory.labels.workingScope}</p>
          <ul class="chips">
            {semperStory.capabilities.map((capability) => <li class="chip">{capability}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="founder-section shell" id="company-system" aria-labelledby="systems-heading">
      <header class="page-section-heading">
        <div>
          <p class="eyebrow">{semperStory.systemSection.eyebrow}</p>
          <h2 id="systems-heading">{semperStory.systemSection.heading}</h2>
        </div>
        <p>{semperStory.systemSection.intro}</p>
      </header>

      <ol class="system-cards">
        {semperStory.operatingModel.map((item) => (
          <li>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="founder-section shell" id="federal-readiness" aria-labelledby="readiness-heading">
      <header class="page-section-heading">
        <div>
          <p class="eyebrow">{semperStory.readinessSection.eyebrow}</p>
          <h2 id="readiness-heading">{semperStory.readinessSection.heading}</h2>
        </div>
        <p>{semperStory.readinessSection.intro}</p>
      </header>

      <div class="readiness-list">
        {semperStory.readiness.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>

      <aside class="claim-boundary" aria-label="Certification claim boundary">
        <p class="eyebrow">{semperStory.labels.claimBoundary}</p>
        <div>
          <p>{semperStory.certificationBoundary}</p>
          <a class="text-link" href={site.semper.aboutUrl}>{semperStory.labels.certificationDetails}</a>
        </div>
      </aside>
    </section>

    <section class="company-cta shell" id="next" aria-labelledby="company-cta-heading">
      <p class="eyebrow">{semperStory.closing.eyebrow}</p>
      <h2 id="company-cta-heading">{semperStory.closing.heading}</h2>
      <div>
        <a class="primary-link" href={site.semper.url}>{semperStory.closing.primaryLabel}</a>
        <a class="text-link" href="/work/">{semperStory.closing.secondaryLabel}</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .company-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(19rem, 0.7fr);
    gap: var(--space-cluster);
    align-items: end;
    padding-block: clamp(var(--primitive-space-16), 9vw, var(--primitive-space-32));
  }

  .back-link {
    display: inline-block;
    margin-bottom: clamp(var(--primitive-space-12), 7vw, var(--primitive-space-20));
    color: var(--color-ink-subtle);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .company-intro h1 {
    max-width: 10ch;
    margin: var(--primitive-space-5) 0 var(--primitive-space-8);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-hero);
    letter-spacing: var(--primitive-tracking-display);
    line-height: var(--primitive-leading-hero);
  }

  .lead {
    max-width: 46rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-lead);
  }

  .hero-actions,
  .company-cta > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--primitive-space-5) var(--primitive-space-8);
    align-items: center;
    margin-top: var(--primitive-space-10);
  }

  .primary-link {
    display: inline-flex;
    gap: var(--primitive-space-3);
    align-items: center;
    padding: 0.85rem 1.1rem;
    border-radius: var(--primitive-radius-pill);
    background: var(--button-primary-bg);
    color: var(--button-primary-ink);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-small);
    font-weight: 750;
    text-decoration: none;
  }

  .primary-link::after {
    content: "↗";
  }

  .primary-link:hover {
    background: var(--color-accent-soft);
    color: var(--button-primary-ink);
  }

  .status-ledger {
    padding: clamp(var(--primitive-space-8), 4vw, var(--primitive-space-12));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background:
      radial-gradient(circle at 100% 0, rgb(234 127 67 / 13%), transparent 17rem),
      var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .status-ledger h2 {
    max-width: 12ch;
    margin: var(--primitive-space-4) 0 var(--primitive-space-8);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h2);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .status-ledger dl {
    margin: 0;
  }

  .status-ledger dl div {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--primitive-space-3);
    padding-block: var(--primitive-space-4);
    border-top: 1px solid var(--color-border);
  }

  .status-ledger dt {
    color: var(--color-accent);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
  }

  .status-ledger dd {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-small);
    font-weight: 700;
  }

  .founder-section,
  .company-cta {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
  }

  .page-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 1.05fr);
    gap: var(--space-cluster);
    align-items: end;
    margin-bottom: clamp(var(--primitive-space-12), 7vw, var(--primitive-space-20));
  }

  .page-section-heading h2,
  .company-cta h2 {
    max-width: 13ch;
    margin: var(--primitive-space-4) 0 0;
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-display);
    letter-spacing: var(--primitive-tracking-display);
    line-height: 0.98;
  }

  .page-section-heading > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-lead);
  }

  .model-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: var(--primitive-space-4);
  }

  .model-statement,
  .capability-panel {
    padding: clamp(var(--primitive-space-8), 5vw, var(--primitive-space-12));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
  }

  .model-statement p {
    max-width: 46rem;
    margin: 0 0 var(--primitive-space-6);
    color: var(--color-ink-muted);
    font-size: var(--primitive-type-lead);
  }

  .model-statement p:last-child {
    margin-bottom: 0;
  }

  .capability-panel {
    background: color-mix(in srgb, var(--card-bg) 76%, var(--color-surface-strong));
  }

  .capability-panel .chips {
    margin-top: var(--primitive-space-8);
  }

  .system-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--primitive-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .system-cards li {
    min-height: 26rem;
    padding: clamp(var(--primitive-space-8), 4vw, var(--primitive-space-10));
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
  }

  .system-cards li > span,
  .readiness-list article > span {
    color: var(--color-accent);
    font-family: var(--typeface-mono);
    font-size: var(--primitive-type-micro);
    letter-spacing: var(--primitive-tracking-label);
  }

  .system-cards h3,
  .readiness-list h3 {
    margin: var(--primitive-space-12) 0 var(--primitive-space-5);
    font-family: var(--typeface-display);
    font-size: var(--primitive-type-h3);
    letter-spacing: var(--primitive-tracking-heading);
    line-height: var(--primitive-leading-heading);
  }

  .system-cards p,
  .readiness-list p {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .readiness-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .readiness-list article {
    display: grid;
    grid-template-columns: minmax(3rem, 0.25fr) minmax(0, 1.75fr);
    gap: var(--space-cluster);
    padding-block: var(--primitive-space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .readiness-list h3 {
    margin: 0 0 var(--primitive-space-3);
  }

  .claim-boundary {
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr);
    gap: var(--space-cluster);
    margin-top: var(--primitive-space-12);
    padding: var(--primitive-space-8);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface-raised);
  }

  .claim-boundary div > p {
    max-width: 49rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-weight: 650;
  }

  .claim-boundary .text-link {
    margin-top: var(--primitive-space-5);
  }

  .company-cta {
    padding-bottom: var(--primitive-space-32);
  }

  .company-cta h2 {
    max-width: 17ch;
  }

  @media (max-width: 63.99rem) {
    .company-hero,
    .system-cards {
      grid-template-columns: 1fr;
    }

    .status-ledger {
      max-width: 43rem;
    }

    .system-cards li {
      min-height: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .company-hero,
    .page-section-heading,
    .model-grid,
    .claim-boundary {
      grid-template-columns: 1fr;
    }

    .company-intro h1 {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }

    .page-section-heading {
      align-items: start;
    }

    .readiness-list article {
      grid-template-columns: 2.5rem 1fr;
      gap: var(--primitive-space-4);
    }
  }
</style>
