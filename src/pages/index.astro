---
import ContactSection from "@/components/ContactSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import SemperSection from "@/components/SemperSection.astro";
import WorkPreview from "@/components/WorkPreview.astro";
import { resumes } from "@/data/portfolio";
import BaseLayout from "@/layouts/BaseLayout.astro";

const missingResumes = resumes.filter((resume) => !resume.available);
if (missingResumes.length > 0) {
  console.warn(
    `[resumes] Placeholder links remain for: ${missingResumes.map((resume) => resume.href).join(", ")}`,
  );
}

---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <WorkPreview />
    <SemperSection />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
